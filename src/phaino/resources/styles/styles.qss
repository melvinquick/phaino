/* =========================================
   BASE WIDGETS & GLOBAL
   ========================================= */

QWidget {
    background-color: {{background-color}};
    color: {{color}};
    font-family: "{{font-family}}";
    font-size: {{font-size-base}};
}

QMainWindow, QDialog {
    background-color: {{background-color}};
}

QToolTip {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
}

QLabel {
    background: transparent;
    color: {{color}};
}

QMenuBar {
    background-color: {{surface-color}};
    color: {{color}};
    border-bottom: {{border}};
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: {{border-radius}};
}

QMenuBar::item:selected {
    background-color: {{widget-background-color}};
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
    border-radius: {{border-radius}};
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QFrame#Card, QFrame#Section {
    background-color: {{surface-color}};
    border: {{border}};
    border-radius: {{border-radius}};
}

QLabel#DialogTitle {
    font-size: {{font-size-lg}};
    font-weight: 700;
    color: {{color}};
}

QLabel#SectionTitle {
    font-size: {{font-size-lg}};
    font-weight: 700;
    color: {{color}};
    padding-bottom: 8px;
    border-bottom: {{border}};
}

QLabel#MutedLabel {
    color: {{muted-color}};
    font-size: {{font-size-base}};
}

/* =========================================
   BUTTONS
   ========================================= */

QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    min-height: 24px;
}

QPushButton:hover {
    border-color: {{accent-color}};
}

QPushButton:pressed {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

QPushButton:disabled {
    color: {{muted-color}};
    background-color: {{surface-color}};
}

QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    border: 1px solid {{accent-color}};
    font-weight: 700;
    padding: 12px 16px;
    font-size: {{font-size-lg}};
}

QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
    border-color: {{accent-hover-color}};
}

QPushButton#PrimaryButton:pressed {
    background-color: {{accent-color}};
    border-color: {{accent-color}};
}

QPushButton#IconButton {
    background: transparent;
    border: none;
    padding: 0;
}

QPushButton#IconButton:hover {
    background-color: {{surface-color}};
    border-radius: {{border-radius}};
}

/* =========================================
   INPUTS & COMBOBOXES
   ========================================= */

QLineEdit, QPlainTextEdit, QSpinBox, QComboBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding-v}} {{padding-h}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QComboBox:focus {
    border: 1px solid {{accent-color}};
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
    outline: none;
}

/* =========================================
   CHECKBOXES
   ========================================= */

QCheckBox {
    color: {{color}};
    spacing: 8px;
    background: transparent;
    padding: 4px 0px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: {{border}};
    border-radius: 3px;
    background-color: {{widget-background-color}};
}

QCheckBox::indicator:checked {
    background-color: {{accent-color}};
    border-color: {{accent-color}};
    image: url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSJ3aGl0ZSIgc3Ryb2tlLXdpZHRoPSIzIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiPjxwb2x5bGluZSBwb2ludHM9IjIwIDYgOSAxNyA0IDEyIj48L3BvbHlsaW5lPjwvc3ZnPg==);
}

/* =========================================
   SCROLLBARS & SLIDERS
   ========================================= */

QScrollBar:vertical {
    border: none;
    background: {{background-color}};
    width: 12px;
    margin: 0px; 
}

QScrollBar::handle:vertical {
    background: {{widget-background-color}};
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: {{accent-color}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; 
}

QScrollArea {
    border: none;
    background-color: transparent;
}

/* =========================================
   MAIN LAYOUT & CONTAINERS
   ========================================= */

#MainWindowContent {
    background-color: {{background-color}};
}

QWidget#EditorContainer {
    border-left: {{border}};
}

QSplitter::handle {
    background-color: {{muted-color}}; 
    width: 4px;
}

QStatusBar {
    background-color: {{surface-color}};
    color: {{color}};
    border-top: {{border}};
}

QStatusBar QLabel {
    color: {{color}};
    padding: 0px 8px;
    font-size: {{font-size-base}};
}

/* =========================================
   BREADCRUMBS
   ========================================= */

#BreadcrumbContainer {
    background-color: transparent;
}

QPushButton#BreadcrumbSegment {
    background-color: transparent;
    color: {{muted-color}};
    border: none;
    padding: 0px 4px;
    font-size: {{font-size-base}};
}

QPushButton#BreadcrumbSegment:hover {
    color: {{color}};
    text-decoration: underline;
}

QPushButton#BreadcrumbFile {
    background-color: transparent;
    color: {{color}};
    border: none;
    padding: 0px 4px;
    font-size: {{font-size-base}};
}

QPushButton#BreadcrumbFile:hover {
    text-decoration: underline;
}

QLabel#BreadcrumbSeparator {
    color: {{muted-color}};
    font-size: {{font-size-base}};
    padding: 0px 1px;
}

/* =========================================
   FILE EXPLORER
   ========================================= */

QLineEdit#PathInput {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    border-bottom: {{border}};
    border-radius: 0px;
    padding: 8px;
    font-size: {{font-size-base}};
}

QLineEdit#PathInput:focus {
    border-bottom: 1px solid {{accent-color}};
}

QTreeView {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-base}};
}

QTreeView::item {
    padding: 4px;
}

QTreeView::item:hover {
    background-color: {{surface-color}};
}

QTreeView::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* =========================================
   TABS
   ========================================= */

QTabWidget {
    background-color: {{background-color}};
}

QTabWidget::pane {
    border: none;
    background-color: {{background-color}};
}

QTabBar {
    background-color: {{background-color}};
    border: none;
    font-size: {{font-size-base}};
}

QTabBar::tab {
    background-color: {{surface-color}};
    color: {{muted-color}};
    padding: 6px 12px;
    padding-right: 16px;
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    margin-top: 4px;
}

QTabBar::tab:selected {
    background-color: {{background-color}};
    color: {{color}};
}

QTabBar::tab:hover:!selected {
    background-color: {{widget-background-color}};
}

QPushButton#NewTabButton {
    background-color: transparent;
    color: {{muted-color}};
    border: none;
    font-size: {{font-size-lg}};
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

QPushButton#NewTabButton:hover {
    color: {{accent-color}};
    background-color: {{surface-color}};
    border-radius: 4px;
}

/* =========================================
   TERMINAL
   ========================================= */

#TerminalOutput {
    border-top: {{border}};
    padding: 5px;
    font-family: 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: {{font-size-base}};
}

#TerminalInput {
    background-color: {{surface-color}};
    color: {{color}};
    border: none;
    border-top: {{border}};
    padding: 6px 8px;
    font-family: 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: {{font-size-base}};
}

#TerminalInput:focus {
    border-top: 1px solid {{accent-color}};
}

#TerminalStopButton {
    background-color: {{danger-color}};
    color: {{accent-text-color}};
    border: none;
    font-weight: bold;
    font-size: {{font-size-base}};
    border-radius: 4px;
    margin: 4px;
}

#TerminalStopButton:hover {
    background-color: {{accent-hover-color}};
}

#TerminalStopButton:disabled {
    background-color: {{widget-background-color}};
    color: {{muted-color}};
}

/* =========================================
   FIND / REPLACE
   ========================================= */

#FindReplaceWidget {
    background-color: {{surface-color}};
    border-bottom: {{border}};
}

QPushButton#CloseFindButton {
    background-color: transparent;
    color: {{muted-color}};
    font-weight: bold;
    padding: 4px;
    border: none;
    font-size: {{font-size-base}};
}

QPushButton#CloseFindButton:hover {
    color: {{danger-color}};
}

/* =========================================
   SEARCH PANEL
   ========================================= */

#SearchPanel {
    background-color: {{background-color}};
}

#SearchPanel QLineEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: 4px;
    padding: 6px;
    font-size: {{font-size-base}};
}

#SearchPanel QLineEdit:focus {
    border: 1px solid {{accent-color}};
}

#SearchPanel QPushButton {
    padding: 4px 8px;
    font-size: {{font-size-base}};
    border-radius: 4px;
}

#SearchPanel QTreeWidget {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-base}};
}

#SearchPanel QTreeWidget::item {
    padding: 3px;
}

#SearchPanel QTreeWidget::item:hover {
    background-color: {{surface-color}};
}

#SearchPanel QTreeWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#SearchPanel QTreeWidget::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{color}};
    border-radius: 3px;
    background-color: transparent;
}

#SearchPanel QTreeWidget::indicator:checked {
    border: 1px solid {{color}};
    background-color: {{color}};
}

#SearchPanel QTreeWidget::indicator:hover {
    border: 1px solid {{accent-color}};
}

#SearchPanel QHeaderView::section {
    background-color: {{background-color}};
    color: {{muted-color}};
    padding: 4px;
    border: none;
    border-bottom: {{border}};
    font-weight: bold;
    font-size: {{font-size-base}};
}

#SearchPanel QHeaderView {
    background-color: {{background-color}};
}

/* =========================================
   PREFERENCES DIALOG
   ========================================= */

#PreferencesDialog {
    background-color: {{background-color}};
}

#PreferencesDialog QLabel {
    color: {{color}};
    font-size: {{font-size-base}};
}

#PreferencesDialog QGroupBox {
    color: {{color}};
    font-weight: bold;
    border: {{border}};
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
    font-size: {{font-size-base}};
}

#PreferencesDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 5px;
}

#PreferencesDialog QComboBox,
#PreferencesDialog QSpinBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: 4px;
    padding: 4px;
    font-size: {{font-size-base}};
}

#PreferencesDialog QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

#PreferencesDialog QCheckBox {
    color: {{color}};
    font-size: {{font-size-base}};
    spacing: 8px;
}

#PreferencesDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{color}};
    border-radius: 3px;
    background-color: transparent;
}

#PreferencesDialog QCheckBox::indicator:checked {
    border: 1px solid {{color}};
    background-color: {{color}};
}

#PreferencesDialog QCheckBox::indicator:hover {
    border: 1px solid {{accent-color}};
}

#PreferencesDialog QScrollArea {
    border: {{border}};
    border-radius: 4px;
    background-color: {{surface-color}};
}

#PreferencesDialog QScrollArea QWidget {
    background-color: {{surface-color}};
}

/* =========================================
   CUSTOM TITLE BAR
   ========================================= */

#TitleBar {
    background-color: {{surface-color}};
    border-bottom: {{border}};
}

QPushButton#MenuButton {
    background-color: transparent;
    color: {{color}};
    border: none;
    padding: 0px 12px;
    font-size: {{font-size-base}};
    border-radius: 0px;
}

QPushButton#MenuButton:hover {
    background-color: {{widget-background-color}};
}

QPushButton#MenuButton::menu-indicator {
    image: none;
}

QPushButton#WindowDot {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin-left: 8px;
}

/* =========================================
   SHORTCUTS WINDOW
   ========================================= */

#ShortcutsWindow {
    background-color: {{background-color}};
}

#ShortcutsTitle {
    color: {{color}};
    font-size: {{font-size-lg}};
    font-weight: bold;
    margin-bottom: 15px;
}

#ShortcutSection {
    color: {{accent-color}};
    font-size: {{font-size-base}};
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 5px;
}

#ShortcutKey {
    color: {{warning-color}};
    font-weight: bold;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: {{font-size-base}};
}

#ShortcutDesc {
    color: {{color}};
    font-size: {{font-size-base}};
}

/* =========================================
   COMMAND PALETTE
   ========================================= */

#CommandPalette {
    background-color: {{background-color}};
}

#CommandPalette QLineEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{accent-color}};
    border-radius: 4px;
    padding: 8px;
    font-size: {{font-size-base}};
}

#CommandPalette QListWidget {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: 4px;
    outline: none;
    font-size: {{font-size-base}};
}

#CommandPalette QListWidget::item {
    padding: 6px;
    border: none;
    color: {{color}};
}

#CommandPalette QListWidget::item:hover {
    background-color: {{widget-background-color}};
}

#CommandPalette QListWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#CommandPaletteHint {
    color: {{muted-color}};
    font-size: {{font-size-base}};
}

/* =========================================
   GIT PANEL
   ========================================= */

#GitPanel QTableWidget {
    background-color: {{surface-color}};
    color: {{color}};
    border: none;
    gridline-color: transparent;
    outline: none;
    font-size: {{font-size-base}};
}

#GitPanel QTableWidget::item {
    padding: 6px 6px 6px 5px;
    border: none;
    color: {{color}};
}

#GitPanel QTableWidget::item:hover {
    background-color: {{widget-background-color}};
}

#GitPanel QTableWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#GitPanel QTableWidget::item:disabled {
    background-color: {{surface-color}};
    color: {{muted-color}};
    border-bottom: {{border}};
}

#GitPanel QHeaderView::section {
    background-color: {{surface-color}};
    color: {{muted-color}};
    padding: 6px;
    border: none;
    border-bottom: {{border}};
    font-weight: bold;
    font-size: {{font-size-base}};
}

#GitBranchLabel {
    color: {{color}};
    font-size: {{font-size-lg}};
    font-weight: bold;
    padding: 5px 0px;
}

#GitPanel QTextEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: {{border}};
    border-radius: 4px;
    padding: 5px;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: {{font-size-base}};
}

#GitPanel QPushButton {
    padding: 6px;
    font-size: {{font-size-base}};
    border-radius: 4px;
}

#GitPanel QLabel#CommitMessageLabel {
    color: {{color}};
    font-size: {{font-size-base}};
    margin-top: 5px;
}

/* =========================================
   PROJECTS PANEL
   ========================================= */

#ProjectsPanel {
    background-color: {{background-color}};
}

#ProjectsHintLabel {
    color: {{muted-color}};
    font-size: {{font-size-base}};
    padding: 8px;
}

#ProjectsPanel QListWidget {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-base}};
}

#ProjectsPanel QListWidget::item {
    padding: 6px;
    border: none;
    color: {{color}};
}

#ProjectsPanel QListWidget::item:hover {
    background-color: {{surface-color}};
}

#ProjectsPanel QListWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#ProjectsPanel QPushButton {
    padding: 6px;
    font-size: {{font-size-base}};
    border-radius: 4px;
}

/* =========================================
   ABOUT DIALOG
   ========================================= */

#AboutDialog {
    background-color: {{background-color}};
}

#AboutDialog QLabel {
    color: {{color}};
    background-color: transparent;
}

#AboutDialog QLabel#AppName {
    font-size: 24px;
    font-weight: bold;
    margin-top: 10px;
}

#AboutDialog QLabel#AppVersion {
    font-size: 14px;
    color: {{muted-color}};
}

#AboutDialog QLabel#AppAuthor, 
#AboutDialog QLabel#AppLicense {
    font-size: 13px;
    color: {{color}};
}

#AboutDialog QLabel#LinkLabel {
    font-size: 13px;
}

/* =========================================
   PHAINO SPECIFIC LAYOUT OVERRIDES
   ========================================= */

/* Tighter padding for IDE elements */
QTabBar::tab {
    padding: 4px 12px;
    margin-right: 2px;
}

QPushButton {
    padding: 4px 8px;
}

QLineEdit {
    padding: 4px 8px;
}

QTreeView::item {
    padding: 2px;
}

QMenu::item {
    padding: 4px 20px;
}

/* Fix the sidebar tab bar (Explorer, Source Control, etc) */
#SidebarTabs QTabBar::tab {
    padding: 6px 12px;
}

/* Fix the sidebar search/path inputs */
QLineEdit#PathInput {
    padding: 4px 8px;
}

/* Fix the terminal layout */
#TerminalOutput {
    padding: 4px;
}

#TerminalInput {
    padding: 4px 8px;
}

/* Ensure the editor text area has zero margins so it fills the space */
QPlainTextEdit {
    padding: 0px;
    border: none;
}

QWidget#EditorContainer {
    padding: 0px;
    margin: 0px;
}

/* =========================================
   PHAINO BACKGROUND & SIDEBAR FIXES
   ========================================= */

/* 1. Fix the Editor & Terminal "Gray" Backgrounds */
QPlainTextEdit {
    background-color: {{background-color}};
    border: none;
}

#TerminalOutput {
    background-color: {{background-color}};
}

/* 2. Fix the Crushed Sidebar Tabs */
#SidebarTabs QTabBar::tab {
    padding: 4px 8px;
    font-size: 11px;
}

/* 3. Fix the Path Input Crushing */
QLineEdit#PathInput {
    padding: 2px 6px;
    min-height: 20px;
}