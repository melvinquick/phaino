/* =========================================
   BASE WIDGETS
   ========================================= */

QLineEdit {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
    font-size: {{font-size-md}};
    selection-background-color: {{accent-color}};
}

QLineEdit:focus {
    border: 1px solid {{accent-color}};
}

QPushButton {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: {{border}};
    border-radius: {{border-radius}};
    padding: {{padding}};
    font-size: {{font-size-md}};
}

QPushButton:hover {
    border-color: {{accent-color}};
}

QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    border: none;
    font-weight: 700;
    padding: 12px 16px;
    font-size: {{font-size-lg}};
}

QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
}

QPlainTextEdit {
    background-color: {{background-color}};
    color: {{color}};
    border: 1px solid {{border}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
    padding: 10px;
}

QScrollBar:vertical {
    border: none;
    background: {{background-color}};
    width: 12px;
    margin: 0px; 
}

QScrollBar::handle:vertical {
    background: {{widget-background-color}};
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: {{accent-color}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; 
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QMenu {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{border}};
    font-size: {{font-size-sm}};
}

QMenu::item {
    padding: 6px 24px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* =========================================
   MAIN LAYOUT & CONTAINERS
   ========================================= */

#MainWindowContent {
    background-color: {{background-color}};
}

QWidget#EditorContainer {
    border-left: 1px solid {{border}};
}

QSplitter::handle {
    background-color: {{muted-color}}; 
    width: 4px;
}

QStatusBar {
    background-color: {{surface-color}};
    color: {{color}};
    border-top: 1px solid {{border}};
}

QStatusBar QLabel {
    color: {{color}};
    padding: 0px 8px;
    font-size: {{font-size-sm}};
}

/* =========================================
   BREADCRUMBS
   ========================================= */

#BreadcrumbContainer {
    background-color: transparent;
}

QPushButton#BreadcrumbSegment {
    background-color: transparent;
    color: {{muted-color}};
    border: none;
    padding: 0px 4px;
    font-size: {{font-size-xs}};
}

QPushButton#BreadcrumbSegment:hover {
    color: {{color}};
    text-decoration: underline;
}

QPushButton#BreadcrumbFile {
    background-color: transparent;
    color: {{color}};
    border: none;
    padding: 0px 4px;
    font-size: {{font-size-xs}};
}

QPushButton#BreadcrumbFile:hover {
    text-decoration: underline;
}

QLabel#BreadcrumbSeparator {
    color: {{muted-color}};
    font-size: {{font-size-xs}};
    padding: 0px 1px;
}

/* =========================================
   FILE EXPLORER
   ========================================= */

QLineEdit#PathInput {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    border-bottom: 1px solid {{border}};
    border-radius: 0px;
    padding: 8px;
    font-size: {{font-size-sm}};
}

QLineEdit#PathInput:focus {
    border-bottom: 1px solid {{accent-color}};
}

QTreeView {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-sm}};
}

QTreeView::item {
    padding: 4px;
}

QTreeView::item:hover {
    background-color: {{surface-color}};
}

QTreeView::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

/* =========================================
   TABS
   ========================================= */

QTabWidget {
    background-color: {{background-color}};
}

QTabWidget::pane {
    border: none;
    background-color: {{background-color}};
}

QTabBar {
    background-color: {{background-color}};
    border: none;
    font-size: {{font-size-sm}};
}

QTabBar::tab {
    background-color: {{surface-color}};
    color: {{muted-color}};
    padding: 6px 12px;
    padding-right: 16px;
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    margin-top: 4px;
}

QTabBar::tab:selected {
    background-color: {{background-color}};
    color: {{color}};
}

QTabBar::tab:hover:!selected {
    background-color: {{widget-background-color}};
}

QPushButton#NewTabButton {
    background-color: transparent;
    color: {{muted-color}};
    border: none;
    font-size: {{font-size-lg}};
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

QPushButton#NewTabButton:hover {
    color: {{accent-color}};
    background-color: {{surface-color}};
    border-radius: 4px;
}

/* =========================================
   TERMINAL
   ========================================= */

#TerminalOutput {
    border-top: 1px solid {{border}};
    padding: 5px;
    font-family: 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: {{font-size-sm}};
}

#TerminalInput {
    background-color: {{surface-color}};
    color: {{color}};
    border: none;
    border-top: 1px solid {{border}};
    padding: 6px 8px;
    font-family: 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
    font-size: {{font-size-sm}};
}

#TerminalInput:focus {
    border-top: 1px solid {{accent-color}};
}

#TerminalStopButton {
    background-color: {{danger-color}};
    color: {{accent-text-color}};
    border: none;
    font-weight: bold;
    font-size: {{font-size-xs}};
    border-radius: 4px;
    margin: 4px;
}

#TerminalStopButton:hover {
    background-color: {{accent-hover-color}};
}

#TerminalStopButton:disabled {
    background-color: {{widget-background-color}};
    color: {{muted-color}};
}

/* =========================================
   FIND / REPLACE
   ========================================= */

#FindReplaceWidget {
    background-color: {{surface-color}};
    border-bottom: 1px solid {{border}};
}

QPushButton#CloseFindButton {
    background-color: transparent;
    color: {{muted-color}};
    font-weight: bold;
    padding: 4px;
    border: none;
    font-size: {{font-size-sm}};
}

QPushButton#CloseFindButton:hover {
    color: {{danger-color}};
}

/* =========================================
   SEARCH PANEL
   ========================================= */

#SearchPanel {
    background-color: {{background-color}};
}

#SearchPanel QLineEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 6px;
    font-size: {{font-size-md}};
}

#SearchPanel QLineEdit:focus {
    border: 1px solid {{accent-color}};
}

#SearchPanel QPushButton {
    padding: 4px 8px;
    font-size: {{font-size-sm}};
    border-radius: 4px;
}

#SearchPanel QTreeWidget {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-sm}};
}

#SearchPanel QTreeWidget::item {
    padding: 3px;
}

#SearchPanel QTreeWidget::item:hover {
    background-color: {{surface-color}};
}

#SearchPanel QTreeWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#SearchPanel QTreeWidget::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{color}};
    border-radius: 3px;
    background-color: transparent;
}

#SearchPanel QTreeWidget::indicator:checked {
    border: 1px solid {{color}};
    background-color: {{color}};
}

#SearchPanel QTreeWidget::indicator:hover {
    border: 1px solid {{accent-color}};
}

#SearchPanel QHeaderView::section {
    background-color: {{background-color}};
    color: {{muted-color}};
    padding: 4px;
    border: none;
    border-bottom: 1px solid {{border}};
    font-weight: bold;
    font-size: {{font-size-sm}};
}

#SearchPanel QHeaderView {
    background-color: {{background-color}};
}

/* =========================================
   PREFERENCES DIALOG
   ========================================= */

#PreferencesDialog {
    background-color: {{background-color}};
}

#PreferencesDialog QLabel {
    color: {{color}};
    font-size: {{font-size-md}};
}

#PreferencesDialog QGroupBox {
    color: {{color}};
    font-weight: bold;
    border: 1px solid {{border}};
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 12px;
    font-size: {{font-size-md}};
}

#PreferencesDialog QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0px 5px;
}

#PreferencesDialog QComboBox,
#PreferencesDialog QSpinBox {
    background-color: {{widget-background-color}};
    color: {{color}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 4px;
    font-size: {{font-size-md}};
}

#PreferencesDialog QComboBox QAbstractItemView {
    background-color: {{surface-color}};
    color: {{color}};
    selection-background-color: {{accent-color}};
    selection-color: {{accent-text-color}};
}

#PreferencesDialog QCheckBox {
    color: {{color}};
    font-size: {{font-size-md}};
    spacing: 8px;
}

#PreferencesDialog QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid {{color}};
    border-radius: 3px;
    background-color: transparent;
}

#PreferencesDialog QCheckBox::indicator:checked {
    border: 1px solid {{color}};
    background-color: {{color}};
}

#PreferencesDialog QCheckBox::indicator:hover {
    border: 1px solid {{accent-color}};
}

#PreferencesDialog QScrollArea {
    border: 1px solid {{border}};
    border-radius: 4px;
    background-color: {{surface-color}};
}

#PreferencesDialog QScrollArea QWidget {
    background-color: {{surface-color}};
}

/* =========================================
   CUSTOM TITLE BAR
   ========================================= */

#TitleBar {
    background-color: {{surface-color}};
    border-bottom: 1px solid {{border}};
}

QPushButton#MenuButton {
    background-color: transparent;
    color: {{color}};
    border: none;
    padding: 0px 12px;
    font-size: {{font-size-md}};
    border-radius: 0px;
}

QPushButton#MenuButton:hover {
    background-color: {{widget-background-color}};
}

QPushButton#MenuButton::menu-indicator {
    image: none;
}

QPushButton#WindowDot {
    background-color: transparent;
    border: none;
    padding: 0px;
    margin-left: 8px;
}

/* =========================================
   SHORTCUTS WINDOW
   ========================================= */

#ShortcutsWindow {
    background-color: {{background-color}};
}

#ShortcutsTitle {
    color: {{color}};
    font-size: {{font-size-lg}};
    font-weight: bold;
    margin-bottom: 15px;
}

#ShortcutSection {
    color: {{accent-color}};
    font-size: {{font-size-md}};
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 5px;
}

#ShortcutKey {
    color: {{warning-color}};
    font-weight: bold;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: {{font-size-sm}};
}

#ShortcutDesc {
    color: {{color}};
    font-size: {{font-size-sm}};
}

/* =========================================
   COMMAND PALETTE
   ========================================= */

#CommandPalette {
    background-color: {{background-color}};
}

#CommandPalette QLineEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{accent-color}};
    border-radius: 4px;
    padding: 8px;
    font-size: {{font-size-md}};
}

#CommandPalette QListWidget {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{border}};
    border-radius: 4px;
    outline: none;
    font-size: {{font-size-sm}};
}

#CommandPalette QListWidget::item {
    padding: 6px;
    border: none;
    color: {{color}};
}

#CommandPalette QListWidget::item:hover {
    background-color: {{widget-background-color}};
}

#CommandPalette QListWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#CommandPaletteHint {
    color: {{muted-color}};
    font-size: {{font-size-xs}};
}

/* =========================================
   GIT PANEL
   ========================================= */

#GitPanel QTableWidget {
    background-color: {{surface-color}};
    color: {{color}};
    border: none;
    gridline-color: transparent;
    outline: none;
    font-size: {{font-size-sm}};
}

#GitPanel QTableWidget::item {
    padding: 6px 6px 6px 5px;
    border: none;
    color: {{color}};
}

#GitPanel QTableWidget::item:hover {
    background-color: {{widget-background-color}};
}

#GitPanel QTableWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#GitPanel QTableWidget::item:disabled {
    background-color: {{surface-color}};
    color: {{muted-color}};
    border-bottom: 1px solid {{border}};
}

#GitPanel QHeaderView::section {
    background-color: {{surface-color}};
    color: {{muted-color}};
    padding: 6px;
    border: none;
    border-bottom: 1px solid {{border}};
    font-weight: bold;
    font-size: {{font-size-sm}};
}

#GitBranchLabel {
    color: {{color}};
    font-size: {{font-size-lg}};
    font-weight: bold;
    padding: 5px 0px;
}

#GitPanel QTextEdit {
    background-color: {{surface-color}};
    color: {{color}};
    border: 1px solid {{border}};
    border-radius: 4px;
    padding: 5px;
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: {{font-size-sm}};
}

#GitPanel QPushButton {
    padding: 6px;
    font-size: {{font-size-md}};
    border-radius: 4px;
}

#GitPanel QPushButton#PrimaryButton {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
    font-weight: bold;
}

#GitPanel QPushButton#PrimaryButton:hover {
    background-color: {{accent-hover-color}};
}

/* =========================================
   PROJECTS PANEL
   ========================================= */

#ProjectsPanel {
    background-color: {{background-color}};
}

#ProjectsHintLabel {
    color: {{muted-color}};
    font-size: {{font-size-sm}};
    padding: 8px;
}

#ProjectsPanel QListWidget {
    background-color: {{background-color}};
    color: {{color}};
    border: none;
    outline: none;
    font-size: {{font-size-sm}};
}

#ProjectsPanel QListWidget::item {
    padding: 6px;
    border: none;
    color: {{color}};
}

#ProjectsPanel QListWidget::item:hover {
    background-color: {{surface-color}};
}

#ProjectsPanel QListWidget::item:selected {
    background-color: {{accent-color}};
    color: {{accent-text-color}};
}

#ProjectsPanel QPushButton {
    padding: 6px;
    font-size: {{font-size-md}};
    border-radius: 4px;
}